# Build output: cargo's, and the installer's (setup.iss writes to build/).
target/
build/
dist/

# OS and editor files
.DS_Store
Thumbs.db
.gemini/
.claude/
.vscode/
.idea/
updates.md
scratch/

# Journals and their SQLite sidecars. A WAL/SHM file is named
# <database><suffix>, so `loan_master.db.bak-shm` ends in neither .db nor
# .bak; the plain suffixes catch those.
*.db
*.db-journal
*.db-wal
*.db-shm
*.bak
*-wal
*-shm

# Runtime artifacts (auto-backups live next to the journal; logs in the user
# state dir, but ignore both in case a journal is opened inside the repo)
backups/
logs/
*.log

# Exports that may contain member data — never commit these. Statements and
# reports are written as PDF, Excel or CSV.
*.xlsx
*.csv
*.pdf
statement_*.html
*_statement_*.html
